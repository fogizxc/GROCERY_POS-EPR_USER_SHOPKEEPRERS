# FreshCart production environment
PORT=4000
NODE_ENV=production
CLIENT_ORIGIN=https://your-domain.example
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=freshcart
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Razorpay Live Mode credentials
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-live-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Frontend build-time API URL. Leave empty when frontend and API share the same origin.
VITE_API_URL=
