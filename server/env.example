PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/freshcart
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
RAZORPAY_KEY_ID=replace-in-production
RAZORPAY_KEY_SECRET=replace-in-production

# Owner admin bootstrap (set these only in Vercel/server environment variables)
ADMIN_LOGIN_ID=owner@example.com
ADMIN_LOGIN_PASSWORD=replace-with-a-strong-password
# Optional when ADMIN_LOGIN_ID is an email
ADMIN_LOGIN_PHONE=9999999999
