PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/freshcart
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
RAZORPAY_KEY_ID=replace-in-production
RAZORPAY_KEY_SECRET=replace-in-production

# Dedicated super admin credentials (set these in Vercel/server environment variables)
SUPER_ADMIN_LOGIN_ID=superadmin@example.com
SUPER_ADMIN_LOGIN_PASSWORD=replace-with-a-strong-password
# Optional when SUPER_ADMIN_LOGIN_ID is an email
SUPER_ADMIN_LOGIN_PHONE=9999999999

# Legacy owner admin variables are still accepted as a fallback.
ADMIN_LOGIN_ID=owner@example.com
ADMIN_LOGIN_PASSWORD=replace-with-a-strong-password
ADMIN_LOGIN_PHONE=9999999999
